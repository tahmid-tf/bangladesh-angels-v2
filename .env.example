APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AamarPay (subscription checkout). Production: AAMARPAY_MODE=live + live credentials.
# Important: checkout POSTs to jsonpost.php (JSON). trxcheck is only for server verification after return.
# If jsonpost returns "Store ID Blocked", contact AamarPay support — that is a merchant account block, not an app error.
AAMARPAY_MODE=sandbox
AAMARPAY_CURRENCY=USD
AAMARPAY_SANDBOX_JSONPOST_URL=https://sandbox.aamarpay.com/jsonpost.php
AAMARPAY_SANDBOX_TRXCHECK_URL=https://sandbox.aamarpay.com/api/v1/trxcheck/request.php
AAMARPAY_SANDBOX_STORE_ID=aamarpaytest
AAMARPAY_SANDBOX_SIGNATURE_KEY=dbb74894e82415a2f7ff0ec3a97e4183
AAMARPAY_LIVE_JSONPOST_URL=https://secure.aamarpay.com/jsonpost.php
AAMARPAY_LIVE_TRXCHECK_URL=https://secure.aamarpay.com/api/v1/trxcheck/request.php
AAMARPAY_LIVE_STORE_ID=
# Optional: if your panel only lists "merchant id", use this when it matches store_id
AAMARPAY_LIVE_MERCHANT_ID=
AAMARPAY_LIVE_SIGNATURE_KEY=
# Allow unsigned /payment/complete?payment_id= for ~24h (legacy redirects only)
AAMARPAY_LEGACY_COMPLETE=false

# Local only: skip gateway and activate subscription when APP_ENV=local
SKIP_PAYMENT_GATEWAY=false

# Google OAuth (BAN OAuth web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# BAN Wealth scheme subscription account shown during bank-transfer checkout.
BAN_WEALTH_BANK_NAME="BRAC Bank, Gulshan Corporate"
BAN_WEALTH_BANK_ACCOUNT_NUMBER="2201 5567 8890"
